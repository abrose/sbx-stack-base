#!/usr/bin/env bash
# Claude statusline in the VM. Sends the payload to the sbx hook first: sbx's own statusline, which reports
# session info to Docker Desktop and prints nothing. Then draws the owner's statusline.sh, which has the sandbox
# form in a VM (IS_SANDBOX). CLAUDE_CONFIG_DIR is the first place where statusline.sh looks for the quota engine,
# then the abrose-plugins marketplace clone in ~/.claude. So it must be absolute and outside the workspace: a
# folder of the workspace must never give the engine.
set -euo pipefail

input=$(cat)
d="$(dirname "$(readlink -f "$0")")"
hook=/usr/local/bin/sbx-claude-hook
if [ -x "$hook" ]; then
  printf '%s' "$input" | "$hook" claude-status || true
fi
printf '%s' "$input" | CLAUDE_CONFIG_DIR="$HOME/.claude/sbx/${SANDBOX_NAME:-sandbox}" \
  CQUOTA_LOG_PATH="$HOME/.claude/usage-log.jsonl" \
  bash "$d/statusline.sh"
